+    def set_en_sequence(self, events):
+        """Execute 1..8 full-state EN events, >=50 us apart, on the MCU."""
+        payload, count = self._encode_en_sequence(events)
+        header = PROTOCOL_HEADERS["SET_POWER_EN_SEQUENCE"]
+        with self._hw_lock:
+            self.last_en_sequence = None
+            try:
+                status, response = self._spi_exchange64(header, payload)
+            except Exception:
+                self.power_en[:] = [None] * 8
+                raise
+            if (len(response) < 11 or list(response[:2]) != header or
+                    response[3] > 7 or response[4] > count or response[6] not in (0, 1)):
+                self.power_en[:] = [None] * 8
+                return StatusCode.TIMEOUT if status == StatusCode.TIMEOUT else StatusCode.FAIL
+            detail, executed, mask, valid = response[3:7]
+            self.last_en_sequence = {
+                'result': detail, 'executed_count': executed,
+                'final_mask': mask, 'state_valid': bool(valid),
+                'max_lateness_us': struct.unpack('<I', bytes(response[7:11]))[0],
+            }
+            if valid:
+                self.power_en[:] = [(mask >> i) & 1 for i in range(8)]
+            elif status == StatusCode.TIMEOUT:
+                self.power_en[:] = [None] * 8
+            if status == StatusCode.OK and detail == 0 and executed == count and valid:
+                return StatusCode.OK
+            return StatusCode.TIMEOUT if status == StatusCode.TIMEOUT else StatusCode.FAIL
+
+    @staticmethod
+    def _en_sequence_array(value):
+        if isinstance(value, (list, tuple)):
+            return list(value)
+        if type(value).__name__ == '_LuaTable':
+            keys = list(value.keys())
+            if set(keys) != set(range(1, len(keys) + 1)):
+                raise ValueError('Sequence tables must be dense 1-based arrays')
+            return [value[i] for i in range(1, len(keys) + 1)]
+        raise ValueError('Expected a list or Lua array')
+
+    @classmethod
+    def _normalize_en_sequence(cls, events):
+        rows = cls._en_sequence_array(events)
+        if not 1 <= len(rows) <= 8:
+            raise ValueError('Expected 1..8 EN events')
+        result = []
+        previous = None
+        for row in rows:
+            row = cls._en_sequence_array(row)
+            if len(row) != 9:
+                raise ValueError('Each event requires time_us followed by 8 EN states')
+            t = row[0]
+            if (isinstance(t, bool) or not isinstance(t, (int, float)) or
+                    not math.isfinite(t) or int(t) != t or not 0 <= t <= 1000000):
+                raise ValueError('time_us must be an integer in 0..1000000')
+            t = int(t)
+            if previous is None and t != 0:
+                raise ValueError('First event must be at 0 us')
+            if previous is not None and t - previous < 50:
+                raise ValueError('Events must increase by at least 50 us')
+            states = row[1:]
+            if any(not isinstance(v, (int, float, bool)) or v not in (0, 1) for v in states):
+                raise ValueError('EN states must be 0 or 1')
+            result.append([t] + [int(v) for v in states])
+            previous = t
+        return result
+
+    @classmethod
+    def _encode_en_sequence(cls, events):
+        rows = cls._normalize_en_sequence(events)
+        payload = bytearray([1, len(rows)])
+        for row in rows:
+            mask = sum(v << i for i, v in enumerate(row[1:]))
+            payload.extend(struct.pack('<IB', row[0], mask))
+        return list(payload), len(rows)
